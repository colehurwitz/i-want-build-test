  "story": "An admin user requests a password reset and wants notifications via both email AND slack. The agent must verify identity, reset the password, then call send_notification twice with different channels. This tests whether the agent can handle multiple tool calls of the same type with different parameters in a single conversation.",
  "goal_details": [
    {
      "args": {
        "email": "admin@company.com",
        "security_answer": "admin123"
      },
      "name": "verify_user_identity-1",
      "type": "tool_call",
      "tool_name": "verify_user_identity"
    },
    {
      "args": {
        "user_id": "U-400",
        "temp_password": "TempPass!2024d"
      },
      "name": "reset_password-1",
      "type": "tool_call",
      "tool_name": "reset_password",
      "arg_matching": {
        "temp_password": "ignore"
      }
    },
    {
      "args": {
        "user_id": "U-400",
        "channel": "email",
        "message": "Your password has been reset. Please log in with your temporary password."
      },
      "name": "send_notification-1",
      "type": "tool_call",
      "tool_name": "send_notification",
      "arg_matching": {
        "message": "fuzzy"
      }
    },
    {
      "args": {
        "user_id": "U-400",
        "channel": "slack",
        "message": "Your password has been reset. Please log in with your temporary password."
      },
      "name": "send_notification-2",
      "type": "tool_call",
      "tool_name": "send_notification",
      "arg_matching": {
        "message": "fuzzy"
      }
    }
  ],
  "starting_sentence": "I'm admin@company.com (answer: 'admin123'), I need my password reset and please notify me via email AND slack"
}
